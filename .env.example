TELEGRAM_BOT_TOKEN=paste-token-from-botfather
# No paid AI key is needed. Score changes are read locally from the video with
# the open-source Tesseract OCR engine included in the Docker image.
# Telegram's cloud Bot API only lets bots download files up to 20 MB.
MAX_TELEGRAM_DOWNLOAD_MB=19
# Link downloads are capped to protect the server disk.
MAX_LINK_DOWNLOAD_MB=300
# Optional YouTube access settings for a Railway IP. Use Railway's secret
# variables, never GitHub or a Telegram message.
YOUTUBE_COOKIES_B64=
YOUTUBE_PO_TOKEN=
