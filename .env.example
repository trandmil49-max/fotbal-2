TELEGRAM_BOT_TOKEN=paste-token-from-botfather
# Needed for automatic match/event analysis. Without it the bot still makes an
# overlay, but asks for the match facts instead of inventing them.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Telegram's cloud Bot API only lets bots download files up to 20 MB.
MAX_TELEGRAM_DOWNLOAD_MB=19
# Link downloads are capped to protect the server disk.
MAX_LINK_DOWNLOAD_MB=300
